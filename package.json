{
  "name": "beffa-automation",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node scripts/select-company.mjs",
    "test:smoke": "node scripts/select-company.mjs --grep @smoke",
    "test:regression": "node scripts/select-company.mjs --grep @regression",
    "test:full": "TEST_TYPE=full node scripts/select-company.mjs --grep @full",
    "test:sales": "npx playwright test --project=Forensic-Sales --project=Sales-Workflows",
    "test:purchase": "npx playwright test --project=Forensic-Purchase --project=Purchase-Workflows",
    "test:inventory": "npx playwright test --project=Forensic-Inventory",
    "test:hr": "npx playwright test --project=HR",
    "clean": "rm -rf test-results/ allure-results/ recordings/ artifacts/ coverage/",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report && npx ts-node scripts/latency.ts",
    "latency:track": "npx ts-node scripts/latency.ts",
    "report:allure": "npm run allure:generate && npx allure open allure-report",
    "analyze:modules": "node scripts/modules.js",
    "report:modules:md": "node scripts/modules.js --markdown",
    "mcp": "ts-node mcp/qa-server.ts"
  },
  "keywords": [],
  "author": "Tekleab",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "zod": "^4.5.4"
  }
}
